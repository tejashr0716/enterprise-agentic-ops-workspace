# Enterprise Agentic Ops Workspace - Environment Configuration Template
# Copy this file to .env and configure appropriate values.

# Application & Server
APP_NAME="Enterprise Agentic Ops Workspace"
APP_ENV="development"
PORT=8000
HOST="127.0.0.1"
LOG_LEVEL="INFO"
SECRET_KEY="insecure-dev-secret-key-change-in-production-must-be-32-bytes"

# LLM Inference Provider
# Supported: "local" (deterministic simulation), "openai", "azure_openai", "anthropic"
LLM_PROVIDER="local"
OPENAI_API_KEY=""
OPENAI_MODEL_NAME="gpt-4o"
ANTHROPIC_API_KEY=""
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_DEPLOYMENT=""

# Enterprise Integrations Mode
# Supported: "simulator" (fully realistic local sandbox), "live"
M365_INTEGRATION_MODE="simulator"
M365_TENANT_ID=""
M365_CLIENT_ID=""
M365_CLIENT_SECRET=""

SAP_INTEGRATION_MODE="simulator"
SAP_ODATA_BASE_URL="https://sandbox.api.sap.com/s4hanacloud/sap/opu/odata/sap/API_PURCHASEORDER_PROCESS_SRV"
SAP_API_KEY=""

# Data Loss Prevention (PII Firewall) Hook
DLP_FIREWALL_ENABLED=true
DLP_REDACTION_MODE="PARTIAL_MASK"

# Database & Storage
DATABASE_PATH="data/workspace.db"
CHECKPOINT_DB_PATH="data/checkpoints.db"
